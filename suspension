%==========================================================================
% Project: Vehicle Suspension Model & Active PID Control Initialization
% Description: Forcibly pushes quarter-car suspension variables directly 
%              into the MATLAB base workspace so Simulink can read them.
% Author: Smyan Aggarwal
% Date: 2026-07-05
%==========================================================================

clear; clc;

% force push all suspension parameters straight to base workspace
assignin('base', 'ms', 250);       % sprung mass (kg)
assignin('base', 'cs', 45);        % unsprung mass (kg)
assignin('base', 'ks', 15000);     % spring stiffness (N/m)
assignin('base', 'c',  1000);      % damping coefficient (N s/m)
assignin('base', 'b',  1000);      % auxiliary coefficient

% force push pid controller gains
assignin('base', 'kp', 100);       % proportional gain
assignin('base', 'ki', 50);        % integral gain
assignin('base', 'kd', 10);        % derivative gain

% force push road profile inputs
assignin('base', 'amplitude', 0.05); % road bump amplitude (m)
assignin('base', 'frequency', 2);    % road frequency (rad/s)

% print out confirmation
fprintf('\n--- Workspace Sync Complete ---\n');
fprintf('All suspension variables have been forcibly injected into the base workspace.\n');
fprintf('You can now hit play on your Simulink model!\n');
