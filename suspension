% setup quarter-car model & check suspension parameters
% author: smyan aggarwal

% system specs (quarter-car)
ms = 250;       % sprung mass, kg
cs = 45;      % unsprung mass, kg
ks = 15000;     % spring rate, N/m
c = 1000;       % damper coefficient, N s/m
b = 1000;       % auxiliary coefficient

% pid gains for active control loop
kp = 100;
ki = 50;
kd = 10;

% road disturbance profile (sine wave)
amp = 0.05;     % meters
freq = 2.0;     % rad/s

% quick sanity check on system dynamics before hitting simulink
omega_n = sqrt(ks / ms);         % natural frequency (rad/s)
zeta = c / (2 * sqrt(ks * ms));  % damping ratio

fprintf('model initialized. body natural freq: %.2f rad/s, damping ratio: %.2f\n', omega_n, zeta);
