% setup quarter-car model & pid controller for simulink
% author: smyan aggarwal

clear; clc;

% system specs
ms = 250;       % sprung mass, kg
m_us = 45;      % unsprung mass, kg
ks = 15000;     % spring rate
c = 1000;       % damper coefficient
b = 1000;       % auxiliary coefficient

% pid gains for active control
kp = 100;
ki = 50;
kd = 10;

% road disturbance inputs (sine wave bump)
amp = 0.05; 
freq = 2.0; 

fprintf('workspace loaded. ready to run simulink.\n');
